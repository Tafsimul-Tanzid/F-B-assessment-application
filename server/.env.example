# Copy to .env for local development (outside Docker).
# docker-compose.yml supplies these itself, so you do not need a .env to run
# `docker compose up`.

NODE_ENV=development
PORT=4010

# Either set DATABASE_URL (what a managed host gives you) ...
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/fnb_pos

# ... or the discrete parts.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=fnb_pos
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Each in-flight sale pins a connection for its whole transaction, so size this
# against peak CONCURRENT SALES, not requests per second.
DB_POOL_MAX=20
DB_POOL_MIN=2

# Required. Must be at least 16 characters; boot fails otherwise.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Per-transaction lock wait ceiling, so one stuck transaction cannot queue an
# entire outlet's sales behind it.
LOCK_TIMEOUT_MS=3000

RUN_MIGRATIONS_ON_BOOT=true
SEED_ON_BOOT=false
