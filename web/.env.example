# Copy to .env for a local production-style build (`npm run build`).
#
# Not needed for `npm run dev` - the Vite dev server proxies /api to the
# backend (see vite.config.js), so requests are same-origin and this is unset.
#
# Baked into the JS bundle at BUILD time, not read at runtime - see the note
# in web/Dockerfile. Never put a secret here: anything under VITE_ is shipped
# to every visitor's browser.
VITE_API_BASE_URL=http://localhost:4010
